{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The KeysReady demo app (web/) as a Cloudflare Worker, built by OpenNext
  // (`npm run deploy`, see README.md "Deploy"). The landing page in ../landing
  // is a separate Worker.
  "name": "keysready",
  "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-28",
  // nodejs_compat is required by OpenNext, and by web-push and the HMAC/scrypt
  // sign-in (node:crypto); global_fetch_strictly_public keeps the server's own
  // fetches (Stripe, push services) on the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served only at its custom domain; deploys keep the domain attached.
  "workers_dev": false,
  "routes": [{ "pattern": "app.keysready.n8builds.dev", "custom_domain": true }],
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Run next to the Turso database (aws-us-east-2): each request makes several
  // queries. Static assets are still served from the edge.
  "placement": { "mode": "targeted", "region": "aws:us-east-2" },
  "vars": {
    // Canonical origin for magic links and redirects (lib/app-url.ts).
    "APP_URL": "https://app.keysready.n8builds.dev",
    "VAPID_SUBJECT": "mailto:nathancwatkins23@gmail.com",    // Public half of the Web Push key pair; the browser fetches it from
    // /api/push/vapid-public-key. VAPID_PRIVATE_KEY is a secret.
    "VAPID_PUBLIC_KEY": "BCZtNXQJPAVj9nyzVablgRxS5tUKoiuSCZ5bO8OH5Vkb5vT4JbOFHv2HzghOI9hx6dnIQi3YMEoHHE-6i_ka05Y",
    // The public demo seeds its staff OWNER login (DEMO_STAFF_EMAIL and
    // DEMO_STAFF_PASSWORD secrets). Never on a real shop's deployment.
    "SEED_DEMO_STAFF": "true",
    // Server errors go to Sentry (worker/sentry.ts). A DSN is public by design:
    // it only lets a sender add events to this one project.
    "SENTRY_DSN": "https://3123f2054201d0d28a6004a0167aaede@o4507767562371072.ingest.us.sentry.io/4512375298654208"
  },
  // Secrets (`wrangler secret put <NAME>`, never in this file): SESSION_SECRET,
  // DATABASE_URL, DATABASE_AUTH_TOKEN, VAPID_PRIVATE_KEY, DEMO_STAFF_EMAIL,
  // DEMO_STAFF_PASSWORD, STRIPE_SECRET_KEY,
  // STRIPE_WEBHOOK_SECRET.
  // Also secrets: TURNSTILE_SECRET_KEY (Siteverify) and TURNSTILE_SITE_KEY (the
  // widget key, public by design; /api/turnstile/site-key hands it to the forms).
  // Magic-link email goes through the mailroom Worker (n8watkins/mailroom), app
  // slice `keysready`: it holds the email binding and the caps, so this Worker
  // has no way to send mail itself (lib/email.ts).
  "services": [
    { "binding": "MAILROOM", "service": "mailroom", "entrypoint": "Mailroom", "props": { "app": "keysready" } }
  ],
  // Durable daily caps on the public forms (lib/limits.ts).
  "d1_databases": [
    { "binding": "LIMITS", "database_name": "keysready-limits", "database_id": "c0417c7a-8076-4458-9136-1c345a8e4bd7" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "upload_source_maps": true
}
