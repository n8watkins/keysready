# Auth / sessions (REQUIRED). The app refuses to start without SESSION_SECRET —
# it signs the HMAC session cookie. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Canonical public origin (REQUIRED in production). Used to build absolute links
# in magic-link emails and post-login redirects. MUST be set in prod so those
# links are never derived from a forgeable Host / X-Forwarded-Host header
# (account-takeover / open-redirect). Local dev falls back to the request origin.
#   APP_URL=https://keysready.vercel.app
APP_URL=

# Demo staff OWNER account — SEEDED ONLY when SEED_DEMO_STAFF=true AND a real
# DEMO_STAFF_PASSWORD is set. Use ONLY on a public demo deployment, NEVER on a
# real customer/production deploy — otherwise it ships a known-credential admin
# login. Choose a strong password (12+ characters). Published defaults are
# rejected, and an existing demo row that still uses one is disabled on boot.
SEED_DEMO_STAFF=false
DEMO_STAFF_EMAIL=demo@keysready.app
DEMO_STAFF_PASSWORD=

# Web Push (VAPID). Generate with:  npx web-push generate-vapid-keys
# Public key must be exposed to the browser via the NEXT_PUBLIC_ copy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourshop.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Driver sign-in email (magic links) — OPTIONAL.
# Without a provider key, magic sign-in links are NOT emailed; they are printed
# to the server console (look for: "[email:dev] magic link for <email> -> <url>").
# Provider order: Brevo (preferred) -> Resend -> dev console. Both are plain
# HTTPS APIs (no SMTP) so they work on Vercel AND Cloudflare Workers.
#   BREVO_API_KEY   — Brevo transactional key (https://brevo.com; "xkeysib-...").
#                     NOTE: disable "Authorized IPs" in Brevo security settings —
#                     serverless egress IPs rotate, so an IP allowlist breaks sends.
#   RESEND_API_KEY  — Resend API key (Bearer token) — used only if BREVO unset.
#   EMAIL_FROM      — sender, e.g. "KeysReady <noreply@yourdomain.com>". The
#                     domain must be authenticated in whichever provider you use.
BREVO_API_KEY=
RESEND_API_KEY=
EMAIL_FROM=

# Database — Turso / libSQL (relational SQLite, NOT Postgres, NOT Google).
# Local dev needs NOTHING: defaults to a SQLite file at .data/app.db.
# Production: create a free Turso DB (`turso db create`) and set:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=your-token

# Payments (Stripe) — OPTIONAL.
# Without them, payments run in demo mode — a Pay button marks the booking paid
# (no real charge, no Stripe account needed). Set both to take real payments:
#   STRIPE_SECRET_KEY     — your Stripe secret key (sk_live_... / sk_test_...).
#   STRIPE_WEBHOOK_SECRET — the signing secret for the /api/webhooks/stripe
#                           endpoint (whsec_...), used to verify Stripe events.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Better Auth — the new auth foundation, mounted at /api/account/* (additive,
# alongside the existing /api/auth/* staff + driver routes). Email+password works
# with no config. Optional:
#   BETTER_AUTH_SECRET — dedicated signing secret (falls back to SESSION_SECRET).
#   BETTER_AUTH_URL    — canonical origin for OAuth callbacks / cookies (falls
#                        back to APP_URL, then http://localhost:2323). Set in prod.
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET — enables "Continue with Google".
#     Create at https://console.cloud.google.com (OAuth client, Web). Authorized
#     redirect URI:  <origin>/api/account/callback/google
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
