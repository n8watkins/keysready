# ─────────────────────────────────────────────────────────────────────────────
# Notification engine configuration
#
# NONE of these are required to run the demo:
#     node server/src/notifications/demo.js
# The demo uses the in-memory SimulationProvider. These vars are only read when
# you switch on the REAL providers (Twilio SMS / Web Push) in production.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio (SMS to customers) ────────────────────────────────────────────────
# Required for the real SMS provider:
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Sender: prefer a Messaging Service SID (handles number pools, opt-out,
# A2P 10DLC compliance). If you don't have one, set TWILIO_FROM_NUMBER instead.
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_FROM_NUMBER=+15125550100

# Optional: per-message delivery status callbacks land at this URL
# (mounted by webhooks.js as POST /webhooks/twilio/status).
TWILIO_STATUS_CALLBACK_URL=https://your-app.example.com/webhooks/twilio/status

# ── Web Push (notifications to staff) ────────────────────────────────────────
# Generate with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:ops@your-shop.example.com

# ── Quiet hours (recipient-local sending window) ─────────────────────────────
# Defaults if unset: 8:00–21:00 in QUIET_HOURS_TZ. Texas is commonly 9:00–21:00.
QUIET_HOURS_START=8
QUIET_HOURS_END=21
QUIET_HOURS_TZ=America/Chicago
